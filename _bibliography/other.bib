@incollection{angenendt2026capabilities,
  abbr={Chapter},
  title={Capabilities That Attract Frictions: Young Firms and Startup Policy in Central Asia},
  author={Angenendt, David},
  booktitle={National Innovation Systems in Central Asia},
  publisher={Springer, Max Planck Institute Book Series},
  year={2026},
  note={Book chapter (under review)},
  abstract={Central Asian governments have introduced a range of startup policies, but their impact on young firms remains unclear. This chapter uses World Bank Enterprise Survey microdata from Kazakhstan, the Kyrgyz Republic, Tajikistan, and Uzbekistan (2008–2024) to assess young firms' capability development and the evolution of entry frictions. Findings show that Central Asian firms face friction levels similar to peers in other post-Soviet and post-socialist economies but have fewer capabilities, indicating that capability constraints are the main barrier. Firm-level regressions reveal that capable young firms tend to operate in high-friction environments, consistent with institutional-voids theory. However, this effect disappears when frictions are measured at the industry level, which instead suggests an attract-frictions mechanism: activities such as certification, exporting, and credit applications increase firms' exposure to inspectors and rent-seeking, thereby raising friction levels. This link between capabilities and frictions discourages investment in productive capabilities, especially among young firms. Uzbekistan represents an exception; its post-2016 liberalisation appears to have weakened this link, enabling broader capability accumulation and yielding the most favourable young-firm outcomes in the region. These results suggest that capability-support interventions will be more effective if paired with measures that reduce regulatory exposure for firms investing in capabilities.},
  summary={Draws on firm surveys from four Central Asian economies to show that young firms are held back less by red tape than by weak capabilities, and that building those capabilities can paradoxically attract more red tape, except where liberalisation (as in Uzbekistan) has loosened the link.}
}

@article{angenendt2024comment,
  abbr={I4R},
  title={A Comment on Sampson (2023)},
  author={Angenendt, David and Bokhari, Farasat and Mariuzzo, Franco and Zhang, Junjun},
  journal={I4R Discussion Paper Series},
  year={2024},
  html={https://www.econstor.eu/handle/10419/290340},
  abstract={In their paper, Sampson (2023) introduces a theoretical framework and conducts empirical testing to elucidate the impact of gaps in countries' innovative efficiencies on income, wages, and trade dynamics. We successfully replicate the paper's findings by running the provided codes, and confirm the absence of any coding errors in the process. We also provide an extensive battery of robustness checks, which confirms the resilience of their results. We then scrutinize two key aspects of their study: the choice of developing countries and the innovation measure employed. The outcomes of this refined analysis partly temper the original paper's message of technology gaps driving inequality, underscoring the need for additional research in this domain.},
  summary={Reproduces Sampson (2023) and stress-tests it. The headline claim that technology gaps drive inequality survives, but softens once the choice of developing countries and innovation measure is examined closely.}
}

@techreport{angenendt2022ncub,
  abbr={Report},
  title={The Changing State of Business-University Interactions in the UK},
  author={Angenendt, David and Hughes, Alan and Kitson, Michael and Salter, Ammon and Hughes, Robert},
  institution={National Centre for Universities and Business (NCUB)},
  year={2022},
  pdf={https://www.ncub.co.uk/wp-content/uploads/2021/07/5334_NCUB_Changing_State_of_Business-University_Interactions-FINAL.pdf},
  code={https://doi.org/10.5255/UKDA-SN-9037-1},
  poster={https://www.ncub.co.uk/wp-content/uploads/2021/07/5548_NCUB_Infographic_V4.pdf},
  website={https://www.ncub.co.uk/insight/the-changing-state-of-business-university-interactions-in-the-uk-2005-to-2021/},
  abstract={This report presents the results of an online survey of UK companies which took place in 2020-2021. The survey was designed to set out and assess the extent and nature of company knowledge exchange interactions with the university sector. It covers the three-year period ending in March 2020 prior to the Covid-19 pandemic. The survey also includes questions relating to the subsequent impact of the pandemic on knowledge exchange patterns. The survey covers 3823 companies in all sectors, regions and countries of the UK and the full range of employment sizes from micro-firms employing less than 10 people to the largest public listed corporations. We use a matched sample of respondents to this survey and to a previous survey to examine changes over the period 2005-2021.},
  summary={A national survey of 3,823 UK companies mapping how, and how much, they exchange knowledge with universities, with comparisons stretching back to 2005.}
}
